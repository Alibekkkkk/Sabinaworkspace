  "readingHtml": "<h1>The Great Flood of Marlowe</h1><div class=\"subtitle\">A story about a natural disaster</div><p><span class=\"para-label\">A.</span>In the spring of 2023, heavy rain fell on the town of Marlowe for three days. The river in the town centre was usually calm, but the rain was too much. The water level rose quickly. On the third day, the river overflowed. Water covered the streets and entered the ground floors of many houses.</p><p><span class=\"para-label\">B.</span>When the flood started, the local council told everyone to evacuate. Rescue teams used small boats to travel through the streets. They helped elderly people and children who were trapped in their homes. The water stayed in the town for a whole week.</p><p><span class=\"para-label\">C.</span>After the water went down, the people of Marlowe began to clean up. The council provided free food and water. Now, the town is making a plan. They want to build new defences to protect the town from future floods.</p>",
  "readingQ": [
    { "id": "sabina.readingQ.001", "type": "short", "prompt": "How many days did the heavy rain fall?", "ru": "Сколько дней шёл сильный дождь?", "answers": ["3", "three"], "exp": "The text says heavy rain fell for three days." },
    { "id": "sabina.readingQ.002", "type": "short", "prompt": "What is the name of the town in the story?", "ru": "Как называется город в этой истории?", "answers": ["marlowe"], "exp": "The town is called Marlowe." },
    { "id": "sabina.readingQ.003", "type": "tfng", "prompt": "The river was usually calm before the rain.", "ru": "Река обычно была спокойной до дождя.", "answer": "True", "exp": "The text says the river was usually calm." },
    { "id": "sabina.readingQ.004", "type": "tfng", "prompt": "Rescue teams used helicopters to save people.", "ru": "Спасательные команды использовали вертолеты для спасения людей.", "answer": "False", "exp": "The text says they used small boats." },
    { "id": "sabina.readingQ.005", "type": "tfng", "prompt": "The water stayed in the town for one month.", "ru": "Вода оставалась в городе в течение одного месяца.", "answer": "False", "exp": "The water stayed for a whole week." },
    { "id": "sabina.readingQ.006", "type": "long", "prompt": "In your own words, explain how the rescue teams helped people during the flood.", "ru": "Своими словами объясните, как спасательные команды помогали людям во время наводнения.", "keywordGroups": [["boat","boats"],["help","save","rescue"],["elderly","old"],["children","kids"],["trapped","stuck","home"]], "minWords": 8, "minGroups": 2, "sample": "The rescue teams used small boats to help elderly people and children who were trapped in their homes.", "exp": "Key ideas: using boats, helping elderly/children, trapped people." },
    { "id": "sabina.readingQ.007", "type": "long", "prompt": "What is the town planning to do to protect itself in the future?", "ru": "Что город планирует сделать, чтобы защитить себя в будущем?", "keywordGroups": [["build","construct","make"],["defences","defense","protection"],["future","next","flood"]], "minWords": 6, "minGroups": 2, "sample": "The town is planning to build new defences to protect the town from future floods.", "exp": "Key ideas: building defences, protecting the town." },
    { "id": "sabina.readingQ.008", "type": "mcq", "prompt": "Why did the river overflow?", "ru": "Почему река вышла из берегов?", "options": ["Because of heavy rain","Because of a heat wave","Because of an earthquake"], "correct": "Because of heavy rain", "exp": "Heavy rain caused the river to overflow." },
    { "id": "sabina.readingQ.009", "type": "mcq", "prompt": "What is the town planning to build?", "ru": "Что город планирует построить?", "options": ["New defences","A new hospital","A new school"], "correct": "New defences", "exp": "The town wants to build new defences." },
