  "grammar": [
    {
      "id": "future-forms",
      "title": "Future Forms",
      "exercises": [
        "g6",
        "sbPp"
      ],
      "rule": {
        "formula": "will + V1 · am/is/are going to + V1 · Present Simple for timetables",
        "points": [
          "<b>will</b>: decisions made now, promises and predictions.",
          "<b>going to</b>: plans and intentions: I <b>am going to buy</b> a telescope.",
          "<b>Present simple</b> for timetables: The shuttle <b>leaves</b> at 9 AM."
        ]
      },
      "lead": "Choose the future form that fits the meaning."
    },
    {
      "id": "modal-verbs",
      "title": "Modal Verbs",
      "exercises": [
        "g7",
        "sbPs"
      ],
      "rule": {
        "formula": "Subject + modal + V1",
        "points": [
          "<b>must</b>: strong obligation. <b>must not</b>: it is not allowed.",
          "<b>have to / do not have to</b>: necessary / not necessary.",
          "<b>can</b>: ability or permission. <b>should</b>: advice."
        ]
      },
      "lead": "Choose the modal verb that fits the meaning."
    },
    {
      "id": "mixed-tenses",
      "title": "Mixed Tenses Review",
      "exercises": [
        "g10"
      ],
      "rule": {
        "formula": "Present Continuous for arrangements · Present Perfect with since/for",
        "points": [
          "Arrangements: I <b>am seeing</b> the doctor tomorrow.",
          "Up to now: I <b>have lived</b> here since 2015."
        ]
      },
      "lead": "Look at the time words, then choose the tense."
    }
  ],
